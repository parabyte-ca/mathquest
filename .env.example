# MathQuest configuration. setup.sh creates .env from this file (mode 600). Never commit .env.

# Host port (registered in dev-sop/ports.md). The container always listens on 8086 internally.
MATHQUEST_PORT=8086

# Version of the image to run. update.sh manages this; setup.sh sets it from the VERSION file.
MATHQUEST_VERSION=2.0.2

# Container user. 568 is the TrueNAS "apps" user; data/ and upgrade/ are chowned to it by setup.sh.
MATHQUEST_UID=568
MATHQUEST_GID=568

# Public address (used in sign-in links). Must be https behind the Cloudflare Tunnel.
BASE_URL=https://mathquest.moot.es
# true when served over https (Secure cookies, HSTS). Keep true behind the tunnel.
COOKIE_SECURE=true

# Email (Resend). MAIL_FROM must use the domain verified in Resend (mathquest.moot.es), and the API key
# must be allowed to send from that domain. See README "Email DNS".
RESEND_API_KEY=
MAIL_FROM=MathQuest <mathquest@mathquest.moot.es>
ADMIN_EMAIL=

# Sign-in links: 15 minute expiry, bound to the browser that asked (strict) or not (off).
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_BIND=strict

# Claude API (word problems, richer explanations; used from Phase 3).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Nightly SQLite backups kept for this many days.
BACKUP_RETENTION_DAYS=14

# Where the Updates page looks for the latest release (GitHub API). Leave as is.
# RELEASES_URL=https://api.github.com/repos/parabyte-ca/mathquest/releases/latest
