{
  "name": "mathquest",
  "version": "3.10.0",
  "private": true,
  "description": "Adaptive Ontario math practice and rewards for Grades 5-12 (self-hosted, invite-only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "curriculum:build": "tsx scripts/build-curriculum.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "audit:secrets": "tsx scripts/secret-scan.ts",
    "gen:lessons": "tsx scripts/gen-lesson-map.ts",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mathjs": "^15.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@playwright/test": "^1.50.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "katex": "^0.19.1",
    "preact": "^10.25.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
